# Copy this file to .env and fill in the values.
# Never commit .env — it contains credentials.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
#   DATABASE_URL=sqlite:///violence_detection.db
# PostgreSQL (recommended — requires Docker or a local PG install):
DATABASE_URL=postgresql://violence_user:violence_pass@localhost:5433/violence_db

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ─── VideoMAE tuning (optional) ───────────────────────────────────────────────
VIDEOMAE_THRESHOLD=0.65
VIDEOMAE_SMOOTH_WINDOW=5
VIDEOMAE_MIN_PERSONS=2

# ─── Email (SMTP) — shared by violence alerts and auth verification emails ────
# Leave EMAIL_ENABLED=false for local dev: verification links are logged to
# the console instead of actually being sent, so the flow is fully testable
# without real SMTP credentials.
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
# Base URL of the frontend dev server — used to build the emailed verification link
FRONTEND_URL=http://localhost:3001
EMAIL_VERIFICATION_TTL_HOURS=24
